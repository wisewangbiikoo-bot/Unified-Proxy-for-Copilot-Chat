{
  "schema_version": 2,
  "providers": [
    {
      "id": "opencode-go",
      "name": "OpenCode Go",
      "base_url": "https://opencode.ai/zen/go/v1",
      "api_key": "YOUR_OPENCODE_GO_API_KEY",
      "accounts": [
        { "id": "main", "name": "主号", "api_key": "YOUR_OPENCODE_GO_API_KEY" },
        { "id": "bak", "name": "副号", "api_key": "YOUR_OPENCODE_GO_API_KEY_2" }
      ],
      "account_switch": {
        "mode": "manual",
        "rotate_minutes": 5,
        "rotate_every_n_requests": 10
      }
    },
    {
      "id": "lan-proxy",
      "name": "LAN Proxy",
      "base_url": "http://proxy.example.com:4150/v1",
      "api_key": "YOUR_LAN_API_KEY"
    }
  ],
  "models": [
    {
      "id": "opencode-go__deepseek-v4.1-flash",
      "provider_id": "opencode-go",
      "model_id": "deepseek-v4.1-flash",
      "enabled": true,
      "name": "DeepSeek V4.1 Flash",
      "params": {
        "context_window_size": 0,
        "max_output_tokens": 0,
        "supports_images": 0,
        "supports_tools": 1,
        "supports_thinking": 1,
        "temperature": 0.3,
        "thinking_mode": "标准"
      },
      "param_source": "auto"
    },
    {
      "id": "lan-proxy__gemini-2.5-flash-lite",
      "provider_id": "lan-proxy",
      "model_id": "gemini-2.5-flash-lite",
      "enabled": true,
      "name": "Gemini 2.5 Flash Lite",
      "params": {
        "context_window_size": 0,
        "max_output_tokens": 0,
        "supports_images": 2,
        "supports_tools": 1,
        "supports_thinking": 0
      },
      "param_source": "auto"
    }
  ],
  "aux": {
    "vision": { "ref": "lan-proxy__gemini-2.5-flash-lite" },
    "web_extract": { "ref": null }
  }
}
