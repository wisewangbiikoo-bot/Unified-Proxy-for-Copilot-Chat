# --- User / local config (may contain API keys, LAN IPs) ---
proxy_configs.json
proxy_configs.local.json
proxy_configs.*.json
!proxy_configs.json.example
proxy_configs_for_vscode.json

# --- Secrets & environment ---
.env
.env.*
*.pem
*.key
secrets.json
credentials.json
*.secret

# --- Extension packaging / dependencies ---
*.vsix
node_modules/
.npm/
package-lock.json

# --- Debug dumps (verbose mode may write prompts & keys) ---
request-dumps/
deepseek-dumps/
**/request-dumps/
**/deepseek-dumps/

# --- Build / tooling ---
out/**/*.map
.vscode-test/
coverage/
dist/
*.tsbuildinfo

# --- OS & editors ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Accidental secret-like filenames ---
*_local.json
*.local.json
config.local.json
